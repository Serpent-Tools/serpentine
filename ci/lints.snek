import "@/rust.snek" as rust;
import "./lib.snek" as lib;

// cargo-hack resolves features per package, so warm with hack itself instead of a unified cook.
clippy_hack = lib::rust
    > Exec("rustup component add clippy")
    > rust::WithBinstall("cargo-hack@=0.6.45", "cargo-hack")
    > rust::WithChef(lib::source_code, "cargo hack --locked --all clippy --all-targets -- -Dwarnings");

serpentine_hack = lib::rust
    > Exec("apt-get update && apt-get install -y gcc-mingw-w64-x86-64-posix")
    > Env("CC_x86_64_pc_windows_gnu", "x86_64-w64-mingw32-gcc-posix")
    > Exec("rustup target add x86_64-pc-windows-gnu")
    > Exec("rustup component add clippy")
    > rust::WithBinstall("cargo-hack@=0.6.45", "cargo-hack")
    > rust::WithChef(lib::source_code, Join("cargo hack",
        " --locked -p serpentine clippy --all-targets",
        " --feature-powerset --target x86_64-unknown-linux-gnu --target x86_64-pc-windows-gnu",
        " -- -Dwarnings"));

clippy = lib::rust 
    > Exec("rustup component add clippy")
    > rust::WithChef(lib::source_code, "cargo clippy --all-targets -- -Dwarnings");

fmt = rust::FmtCheck(lib::source_code, rust::nightly);

export spelling = lib::debian 
    > WorkingDir("/app")
    > rust::WithBinstall("typos-cli@=1.50.1", "typos")
    > With(lib::source_code, ".")
    > Exec("typos");

deny = lib::rust
    > rust::WithBinstall("cargo-deny@=0.20.2", "cargo-deny")
    > With(lib::source_code, ".")
    > Exec("cargo deny check all");

trivy = Image("aquasec/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969") 
    > With(FromHost(".trivyignore.yaml"), ".trivyignore.yaml")
    > With(lib::container_image, "containerd.tar")
    > Exec("trivy image --input containerd.tar --disable-telemetry --exit-code 1 --no-progress --ignorefile .trivyignore.yaml");
    

// --no-global is load bearing: without it the file is read as self hosted
// config, where packageRules go unchecked and an invalid rule validates clean.
renovate_config = Image("ghcr.io/renovatebot/renovate:43.214.1@sha256:55af44f12d1d81aa6155e466ef898b63061f51a0c1e726b7f0df90f13baae8fc")
    > WorkingDir("/app")
    > With(FromHost("renovate.json"), "renovate.json")
    > Exec("renovate-config-validator --strict --no-global renovate.json");

export light_lints = All(clippy, fmt, spelling);
export full_lints = All(clippy_hack, serpentine_hack, fmt, spelling, renovate_config);
export security = All(deny, trivy);

