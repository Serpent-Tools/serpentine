image_with_user = Image("quay.io/prometheus/node-exporter:v1.12.1@sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0")
    > Exec("test $(id -u) = 65534")
    > Exec("test $(id -g) = 65534")
    > Exec("test $(whoami) = nobody");

default_is_root = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:deff987a572bcbbe3059a644d60d6dd1cfbda9b99f9e5a948ee4e5f0d0206cbe")
    > Exec("test $(id -u) = 0")
    > Exec("test $(id -g) = 0")
    > Exec("test $(whoami) = root");

create_new_user = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:deff987a572bcbbe3059a644d60d6dd1cfbda9b99f9e5a948ee4e5f0d0206cbe")
    > WorkingDir("/run")
    > Exec("useradd viv")
    > Exec("install -m 600 -o root -g root /dev/null root.txt")
    > Exec("install -m 600 -o viv -g viv /dev/null viv.txt")
    > Exec("cat root.txt")
    > Exec("cat viv.txt")
    > Exec("apk update")
    > User("viv")
    > Exec("! cat root.txt")
    > Exec("cat viv.txt")
    > Exec("! apk update")
    > Exec("! sudo apk update");

export DEFAULT = !(image_with_user, default_is_root, create_new_user) Noop(0);

