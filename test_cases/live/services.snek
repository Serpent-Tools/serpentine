valkey = ImageService("docker.io/valkey/valkey:9-alpine@sha256:ee91f7a174ac4d6a6b0685b3a60e321f0a9dbbb691f9b0e285be2ba1d1be8328")
    > Env("READY_MARKER", "yes")
    > HealthCheck("test $READY_MARKER = yes && valkey-cli ping", 30);

app = Image("docker.io/valkey/valkey:9-alpine@sha256:ee91f7a174ac4d6a6b0685b3a60e321f0a9dbbb691f9b0e285be2ba1d1be8328");

with_users = app
    > WithService(valkey, "db")
    > Exec("valkey-cli -h db SET users alice");
use_db = with_users
    > Exec("valkey-cli -h db APPEND users ,bob")
    > Exec("test $(valkey-cli -h db GET users) = alice,bob");

db_still_empty = app
    > !use_db WithService(valkey, "db")
    > Exec("test $(valkey-cli -h db EXISTS users) = 0");

fork1 = with_users
    > Exec("valkey-cli -h db SET fork1 present");
fork2 = with_users
    > !fork1 Exec("test $(valkey-cli -h db EXISTS fork1) = 0");

export DEFAULT = !(use_db, db_still_empty, fork1, fork2) Noop(0);
