import "@/rust.snek" as rust;

small_project = rust::stable
    > Exec("cargo init --lib my_test_app")
    > Export("./my_test_app");

alpine = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:1d988eea4370a4fc1a4f21b6aa4db02bff2c0b589fe6d52fc11162549b28288c");

export DEFAULT = All(
    rust::BasicCI(small_project, rust::stable),
    rust::BasicCI(small_project, rust::nightly),

    alpine > rust::WithBinstall("typos-cli", "typos") > Exec("typos --help"),
    // cargo-bounds doesnt have any releases, so this tests the source install path.
    rust::stable > rust::WithBinstall("cargo-bounds") > Exec("cargo bounds --help")
);
