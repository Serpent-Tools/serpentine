base = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:deff987a572bcbbe3059a644d60d6dd1cfbda9b99f9e5a948ee4e5f0d0206cbe")
    > WorkingDir("/app")
    > Exec("touch hello.txt")
    > Exec("mkdir foo")
    > Exec("touch foo/hello.txt");

hello = base > Export("hello.txt");
foo = base > Export("foo");

check_hello = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:deff987a572bcbbe3059a644d60d6dd1cfbda9b99f9e5a948ee4e5f0d0206cbe")
    > With(hello, "nice.txt")
    > Exec("cat nice.txt");

check_foo = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:deff987a572bcbbe3059a644d60d6dd1cfbda9b99f9e5a948ee4e5f0d0206cbe")
    > With(foo, "bar")
    > Exec("cat bar/hello.txt");

export DEFAULT = !(check_hello, check_foo) Noop(0);
