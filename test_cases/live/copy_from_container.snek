base = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:1d988eea4370a4fc1a4f21b6aa4db02bff2c0b589fe6d52fc11162549b28288c")
    > WorkingDir("/app")
    > Exec("touch hello.txt")
    > Exec("mkdir foo")
    > Exec("touch foo/hello.txt");

hello = base > Export("hello.txt");
foo = base > Export("foo");

check_hello = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:1d988eea4370a4fc1a4f21b6aa4db02bff2c0b589fe6d52fc11162549b28288c")
    > With(hello, "nice.txt")
    > Exec("cat nice.txt");

check_foo = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:1d988eea4370a4fc1a4f21b6aa4db02bff2c0b589fe6d52fc11162549b28288c")
    > With(foo, "bar")
    > Exec("cat bar/hello.txt");

export DEFAULT = !(check_hello, check_foo) Noop(0);
