base = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:deff987a572bcbbe3059a644d60d6dd1cfbda9b99f9e5a948ee4e5f0d0206cbe");

def IsEq(a, b) {
    return base > Exec(Join("[ ", ShellEscape(a), " = ", ShellEscape(b), " ]"));    
}

def Foo(a, b = "test") {
    return Join(a, " ", b);
}

def Bar(a = "hello", b = a) {
    return Join(a, " ", b);
}

def Baz(a = "hello", b = Join(a, " world")) {
    return Join(a, " ", b);
}

export DEFAULT = All(
    IsEq(Foo("hello"), "hello test"),
    IsEq(Foo("hello", "vivax"), "hello vivax"),
    IsEq(Bar(), "hello hello"),
    IsEq(Bar("test"), "test test"),
    IsEq(Bar("hello", "world"), "hello world"),
    IsEq(Baz(), "hello hello world"),
    IsEq(Baz("test"), "test test world"),
    IsEq(Baz("test", "vivax"), "test vivax")
);
