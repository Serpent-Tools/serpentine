base = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:deff987a572bcbbe3059a644d60d6dd1cfbda9b99f9e5a948ee4e5f0d0206cbe") > Exec("apk add curl");

server = base
    > Exec("apk add python3")
    > ToService("sleep 60 && python3 -m http.server 8000")
    > HealthCheck("curl -f http://localhost:8000", 70);

export DEFAULT = base > WithService(server, "server") > Exec("curl -f http://server:8000");
