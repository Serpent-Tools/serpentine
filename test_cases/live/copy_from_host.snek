export DEFAULT = Image("quay.io/toolbx-images/alpine-toolbox:3.22@sha256:deff987a572bcbbe3059a644d60d6dd1cfbda9b99f9e5a948ee4e5f0d0206cbe")
    > With(FromHost("Cargo.toml"), "Cargo.toml")
    > Exec("cat Cargo.toml")
    > With(FromHost("src"), "src")
    > Exec("ls src")
    > Exec("cat src/main.rs");
